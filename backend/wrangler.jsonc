{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "card-game-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-23",
  "vars": {
    "ENVIRONMENT": "local",
    "SESSION_TTL_SECONDS": "86400",
    "RATE_LIMIT_PER_MINUTE": "30",
  },
  "durable_objects": {
    "bindings": [
      { "name": "AUTH_SESSION", "class_name": "AuthSessionDurableObject" },
      { "name": "RATE_LIMITER", "class_name": "RateLimiterDurableObject" },
      { "name": "AUTHORITY_GAME", "class_name": "AuthorityGameDurableObject" },
      { "name": "ROOM", "class_name": "RoomDurableObject" },
      { "name": "REALTIME_ROOM", "class_name": "RealtimeRoomDurableObject" },
    ],
  },
  "migrations": [
    {
      "tag": "v1-p3-03-security-baseline",
      "new_sqlite_classes": [
        "AuthSessionDurableObject",
        "RateLimiterDurableObject",
        "AuthorityGameDurableObject",
      ],
    },
    {
      "tag": "v2-p3-05-room-lifecycle",
      "new_sqlite_classes": ["RoomDurableObject"],
    },
    {
      "tag": "v3-p3-06-realtime-room",
      "new_sqlite_classes": ["RealtimeRoomDurableObject"],
    },
  ],
}
